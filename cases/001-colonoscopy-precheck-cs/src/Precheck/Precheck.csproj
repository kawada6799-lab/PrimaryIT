<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>precheck</AssemblyName>
    <RootNamespace>Precheck</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 配布用: フォルダ 1 つ（.NET ランタイム同梱、インストール不要）。
         以前は exe 1 個（PublishSingleFile）だったが、署名の無い巨大な単一 exe はウイルス対策の汎用判定
         （Norton の Win64:Malware-gen など）に引っかかったため、普通の publish に戻した。
         precheck.exe は Microsoft 製の小さな起動用 exe になり、本体は precheck.dll と .NET の DLL 群に分かれる。
         Playwright のドライバ（.playwright フォルダ）は exe の横に置かれる。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <!-- exe の製品情報（プロパティ → 詳細）。空のままだとウイルス対策に疑われやすい -->
    <Version>1.0.0</Version>
    <AssemblyTitle>PrimaryIT precheck</AssemblyTitle>
    <Product>PrimaryIT precheck（大腸カメラ事前診察チェック）</Product>
    <Company>PrimaryIT（かかりつけIT）</Company>
    <Description>Wakumy の予約一覧を読み、大腸カメラ検査の予約に事前診察が無い患者を一覧にする</Description>
    <Copyright>Copyright (c) 2026 PrimaryIT</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <!-- Playwright のドライバ（node）を Windows 用で同梱する -->
    <PlaywrightPlatform>win-x64</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- .playwright\node\win32_x64\node.exe（ドライバ）が publish 先に確実に入るよう、publish 後に明示的にコピーする -->
  <Target Name="CopyPlaywrightDriverToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PlaywrightNode Include="$(PkgMicrosoft_Playwright)/.playwright/node/win32_x64/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_PlaywrightNode)" DestinationFolder="$(PublishDir).playwright/node/win32_x64/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
