<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kenshin</AssemblyName>
    <RootNamespace>Kenshin</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 配布用: フォルダ 1 つ（.NET ランタイム同梱、インストール不要）。単一 exe にはしない（技術方針）。
         RuntimeIdentifier は publish 時に -r win-x64 で指定する（開発・テストは Linux でも行うため csproj には書かない） -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <Version>0.1.0</Version>
    <AssemblyTitle>PrimaryIT kenshin</AssemblyTitle>
    <Product>PrimaryIT kenshin（健診結果作成）</Product>
    <Company>PrimaryIT（かかりつけIT）</Company>
    <Description>健康診断の入力・自動判定・結果のお知らせ作成</Description>
    <Copyright>Copyright (c) 2026 PrimaryIT</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 外向きの通信を持たない方針。Web SDK が自動で付ける HttpClient 系の using を外す（CI の検査にも引っかからないように） -->
    <Using Remove="System.Net.Http" />
    <Using Remove="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.33" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- 写真の読み取り（OCR）：PaddleOCR の ONNX モデルを ONNX Runtime で動かす。外部通信なし。画像処理は ImageSharp 2.x（Apache-2.0） -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 帳票用フォント（IPA P ゴシック、IPA フォントライセンス 1.0 で再配布可） -->
    <None Include="fonts\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- 設定・マスター（配布フォルダ直下の config\ に置く。利用者が書き換える） -->
    <None Include="..\..\config\**" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
